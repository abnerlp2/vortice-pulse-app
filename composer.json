{
    "name": "vortice/pulse-app",
    "description": "Vortice Pulse Application",
    "require": {
        "laravel/framework": "^11.0",
        "laravel/reverb": "^1.10"
    },
    "require-dev": {
        "pestphp/pest": "^2.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "abnerlp2",
            "email": "abnerlp2@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
