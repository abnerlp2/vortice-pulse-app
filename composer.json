{
    "name": "vortice/pulse-app",
    "description": "Vortice Pulse Application",
    "license": "MIT",
    "authors": [
        {
            "name": "abnerlp2",
            "email": "abnerlp2@gmail.com"
        }
    ],
    "require": {
        "laravel/framework": "^11.0",
        "laravel/reverb": "^1.10",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "maatwebsite/excel": "*",
        "predis/predis": "^3.5"
    },
    "require-dev": {
        "laravel/sail": "^1.63",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^2.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
